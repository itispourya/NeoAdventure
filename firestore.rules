rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidSavedLocation(data) {
      return data.keys().hasAll(['userId', 'name', 'lat', 'lng', 'createdAt']) &&
        data.keys().size() == 5 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.lat is number && data.lng is number &&
        data.createdAt is number;
    }

    function isValidSavedLocationUpdate(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.lat is number && data.lng is number &&
        data.createdAt is number;
    }

    match /savedLocations/{locationId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid && isValidId(locationId);
      allow create: if isSignedIn() && isValidId(locationId) && isValidSavedLocation(incoming());
      
      allow update: if isSignedIn() && isValidId(locationId) && existing().userId == request.auth.uid &&
        isValidSavedLocationUpdate(incoming()) && incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'lat', 'lng']);
        
      allow delete: if isSignedIn() && isValidId(locationId) && existing().userId == request.auth.uid;
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
